# 这是个【空壳】, 照着它设环境变量就行, 别把真 key 填进来再提交。
#
# Windows 上推荐设成系统环境变量, 一次设好以后都不用管:
#   [Environment]::SetEnvironmentVariable("GOFREIGHT_API_KEY","你的key","User")
# 设完要【重开一个命令行窗口】才读得到。

GOFREIGHT_API_KEY=

# 你们公司在 GoFreight 的办公室编号(纯数字), 建单必填。
# 跑 python lookup.py offices 可以列出来。
GOFREIGHT_OFFICE_REF=

# 留给本地假服务器调试用的, 平时不用设
# GOFREIGHT_BASE_URL=http://127.0.0.1:8900
